# APP
MODE=dev
LOG_LEVEL=debug
SERVICE_NAME=effective-mobile

SERVER_SCHEME=http
SERVER_DOMAIN=localhost
SERVER_HTTP_PORT=8080
SERVER_GRPC_PORT=50050
SERVER_PROM_PORT=8085

# POSTGRES
POSTGRES_DB=app_db
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# REDIS
REDIS_ADDR=redis:6379
REDIS_PASS=

# JAEGER
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1
JAEGER_REPORTER_LOGSPANS=true
JAEGER_REPORTER_LOCALAGENT=jaeger:6831
JAEGER_REPORTER_COLLECTOR=http://jaeger:14268/api/traces
